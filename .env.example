# Copy this file to .env. Paths are relative to the repository root.
DATASET_DIR=dataset
ARTIFACTS_DIR=artifacts

# Dataset calculations must use this frozen date, not the machine clock.
DATASET_REFERENCE_DATE=2026-10-20

# Optional Phase 8 connection. Offline dataset/search commands need no key.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=1024
LLM_RETRIES=1

# Reserved for the voice phases.
GNANI_API_KEY=
